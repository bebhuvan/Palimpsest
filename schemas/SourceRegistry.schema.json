{
  "$defs": {
    "CommercialRedistribution": {
      "enum": [
        "allowed",
        "conditional",
        "prohibited",
        "unreviewed"
      ],
      "title": "CommercialRedistribution",
      "type": "string"
    },
    "DistributionTier": {
      "enum": [
        "open_core",
        "research_only"
      ],
      "title": "DistributionTier",
      "type": "string"
    },
    "SourceRegistryEntry": {
      "additionalProperties": false,
      "description": "Public policy record; inclusion here is not proof that a source was ingested.",
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SourceRole"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "license_reviewed": {
          "title": "License Reviewed",
          "type": "boolean"
        },
        "commercial_redistribution": {
          "$ref": "#/$defs/CommercialRedistribution"
        },
        "distribution_tier": {
          "$ref": "#/$defs/DistributionTier",
          "default": "open_core"
        },
        "redistribution_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Redistribution Conditions",
          "type": "array"
        },
        "separates_media_rights": {
          "default": false,
          "title": "Separates Media Rights",
          "type": "boolean"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "expected_checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Checksum Sha256"
        },
        "temporal_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Scope"
        },
        "geographic_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geographic Scope"
        },
        "release_policy": {
          "minLength": 1,
          "title": "Release Policy",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "enabled",
        "adapter",
        "roles",
        "title",
        "publisher",
        "url",
        "license_id",
        "license_reviewed",
        "commercial_redistribution",
        "release_policy"
      ],
      "title": "SourceRegistryEntry",
      "type": "object"
    },
    "SourceRole": {
      "description": "The evidentiary job a source is allowed to perform in the product.",
      "enum": [
        "historical_geometry",
        "gazetteer",
        "chronology",
        "authority_metadata",
        "tertiary_summary",
        "primary_source",
        "scholarly_assertion",
        "indicator",
        "media",
        "bibliography"
      ],
      "title": "SourceRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SourceRegistryEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "entries"
  ],
  "title": "SourceRegistry",
  "type": "object"
}
