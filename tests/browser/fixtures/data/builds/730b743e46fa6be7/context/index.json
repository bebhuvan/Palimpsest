{
  "feature_contexts": {
    "count": 2,
    "path_template": "context/features/{shard}.json",
    "shards": [
      "03",
      "35"
    ]
  },
  "ranking_policy": {
    "algorithm": "bounded-explicit-relations-v1",
    "causal_claims_excluded": true,
    "evidence_basis": "Wikidata statements; references retained when supplied",
    "maximum_entities_per_feature": 40,
    "role_quotas": {
      "event": 12,
      "institution": 8,
      "other": 4,
      "person": 12,
      "place": 8,
      "polity": 8,
      "theme": 8
    },
    "temporal_margin_years": 50
  },
  "schema_version": "1.0.0",
  "sharding": {
    "algorithm": "sha256",
    "encoding": "utf-8",
    "prefix_length": 2
  }
}
