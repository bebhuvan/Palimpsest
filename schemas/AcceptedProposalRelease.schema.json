{
  "additionalProperties": false,
  "description": "Immutable linkage from an accepted proposal revision to a release.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantics": {
      "const": "accepted-proposal-release-receipt-not-canonical-record",
      "default": "accepted-proposal-release-receipt-not-canonical-record",
      "title": "Semantics",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^proposal-release:[a-z0-9][a-z0-9:_-]+$",
      "title": "Receipt Id",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^proposal:[a-z0-9][a-z0-9:_-]+$",
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_revision": {
      "minimum": 1,
      "title": "Proposal Revision",
      "type": "integer"
    },
    "proposal_status": {
      "const": "accepted",
      "default": "accepted",
      "title": "Proposal Status",
      "type": "string"
    },
    "decision_event_id": {
      "pattern": "^review:[a-z0-9][a-z0-9:_-]+$",
      "title": "Decision Event Id",
      "type": "string"
    },
    "proposal_checksum_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Proposal Checksum Sha256",
      "type": "string"
    },
    "release_build_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]+$",
      "title": "Release Build Id",
      "type": "string"
    },
    "published_record_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Published Record Ids",
      "type": "array"
    },
    "released_at": {
      "format": "date-time",
      "title": "Released At",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "proposal_id",
    "proposal_revision",
    "decision_event_id",
    "proposal_checksum_sha256",
    "release_build_id",
    "published_record_ids",
    "released_at"
  ],
  "title": "AcceptedProposalRelease",
  "type": "object"
}
