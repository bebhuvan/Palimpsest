          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "encoding": {
          "const": "utf-8",
          "default": "utf-8",
          "title": "Encoding",
          "type": "string"
        },
        "prefix_length": {
          "const": 2,
          "default": 2,
          "title": "Prefix Length",
          "type": "integer"
        }
