{
  "$defs": {
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "modified": {
          "default": false,
          "title": "Modified",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "record_id",
        "title",
        "publisher",
        "url",
        "license_id",
        "retrieved_at",
        "citation"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "indicator_id": {
      "title": "Indicator Id",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "year": {
      "title": "Year",
      "type": "integer"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "original_geographic_unit": {
      "title": "Original Geographic Unit",
      "type": "string"
    },
    "spatial_mapping_valid": {
      "default": false,
      "title": "Spatial Mapping Valid",
      "type": "boolean"
    },
    "spatial_mapping_note": {
      "title": "Spatial Mapping Note",
      "type": "string"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceReference"
    }
  },
  "required": [
    "indicator_id",
    "entity_id",
    "year",
    "value",
    "unit",
    "original_geographic_unit",
    "spatial_mapping_note",
    "source_ref"
  ],
  "title": "IndicatorObservation",
  "type": "object"
}
