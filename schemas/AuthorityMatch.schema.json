{
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "$ref": "#/$defs/ConfidenceGrade"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "grade",
        "rationale"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceGrade": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "unknown"
      ],
      "title": "ConfidenceGrade",
      "type": "string"
    },
    "RightsReference": {
      "additionalProperties": false,
      "description": "A rights decision for one kind of material, never an implicit relicense.",
      "properties": {
        "scope": {
          "$ref": "#/$defs/RightsScope"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "rights_uri": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Uri"
        }
      },
      "required": [
        "scope",
        "license_id",
        "attribution"
      ],
      "title": "RightsReference",
      "type": "object"
    },
    "RightsScope": {
      "enum": [
        "metadata",
        "media",
        "georeference"
      ],
      "title": "RightsScope",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "modified": {
          "default": false,
          "title": "Modified",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "record_id",
        "title",
        "publisher",
        "url",
        "license_id",
        "retrieved_at",
        "citation"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TransformationStep": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        },
        "input_record_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Record Ids",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "operation",
        "tool",
        "tool_version",
        "input_record_ids"
      ],
      "title": "TransformationStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A reviewable authority candidate; a score never silently establishes identity.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "match_id": {
      "pattern": "^match:[a-f0-9]{16}$",
      "title": "Match Id",
      "type": "string"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "authority_id": {
      "minLength": 1,
      "title": "Authority Id",
      "type": "string"
    },
    "authority_namespace": {
      "minLength": 1,
      "title": "Authority Namespace",
      "type": "string"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "relation": {
      "enum": [
        "exact_match",
        "close_match",
        "candidate"
      ],
      "title": "Relation",
      "type": "string"
    },
    "review_status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "confidence_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Confidence Score",
      "type": "number"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceReference"
    },
    "rights": {
      "$ref": "#/$defs/RightsReference"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/TransformationStep"
      },
      "minItems": 1,
      "title": "Lineage",
      "type": "array"
    }
  },
  "required": [
    "match_id",
    "subject_id",
    "authority_id",
    "authority_namespace",
    "label",
    "relation",
    "review_status",
    "confidence_score",
    "confidence",
    "source_ref",
    "rights",
    "lineage"
  ],
  "title": "AuthorityMatch",
  "type": "object"
}
