{
  "$defs": {
    "ContentRole": {
      "enum": [
        "primary_source",
        "tertiary_summary",
        "project_interpretation"
      ],
      "title": "ContentRole",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "modified": {
          "default": false,
          "title": "Modified",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "record_id",
        "title",
        "publisher",
        "url",
        "license_id",
        "retrieved_at",
        "citation"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dossier_id": {
      "title": "Dossier Id",
      "type": "string"
    },
    "dossier_kind": {
      "const": "source_extract",
      "default": "source_extract",
      "title": "Dossier Kind",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "entity_ids": {
      "items": {
        "type": "string"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "content_role": {
      "$ref": "#/$defs/ContentRole",
      "default": "tertiary_summary"
    },
    "extract": {
      "title": "Extract",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "page_id": {
      "title": "Page Id",
      "type": "integer"
    },
    "revision_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Id"
    },
    "revision_timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Timestamp"
    },
    "requested_titles": {
      "items": {
        "type": "string"
      },
      "title": "Requested Titles",
      "type": "array"
    },
    "redirects_from": {
      "items": {
        "type": "string"
      },
      "title": "Redirects From",
      "type": "array"
    },
    "content_checksum_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Checksum Sha256",
      "type": "string"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceReference"
    }
  },
  "required": [
    "dossier_id",
    "title",
    "language",
    "extract",
    "url",
    "page_id",
    "content_checksum_sha256",
    "source_ref"
  ],
  "title": "HistoricalDossier",
  "type": "object"
}
