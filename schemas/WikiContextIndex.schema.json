      ],
      "title": "WikiContextCollection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sharding": {
      "$ref": "#/$defs/ContentSharding"
    },
    "feature_contexts": {
      "$ref": "#/$defs/WikiContextCollection"
    },
    "ranking_policy": {
      "additionalProperties": true,
      "title": "Ranking Policy",
      "type": "object"
    }
  },
  "required": [
    "sharding",
    "feature_contexts",
    "ranking_policy"
  ],
  "title": "WikiContextIndex",
  "type": "object"
}
