{
  "additionalProperties": false,
  "description": "Optional generated wording tied to one exact assertion explanation.",
  "properties": {
    "assertion_id": {
      "pattern": "^assertion:[a-z0-9][a-z0-9:_-]+$",
      "title": "Assertion Id",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "source_excerpt_checksum_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Excerpt Checksum Sha256",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "model_identifier": {
      "minLength": 1,
      "title": "Model Identifier",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "provider_response_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Response Id"
    }
  },
  "required": [
    "assertion_id",
    "text",
    "source_excerpt_checksum_sha256",
    "prompt_version",
    "prompt_sha256",
    "provider",
    "model_identifier",
    "generated_at"
  ],
  "title": "AssertionRestatement",
  "type": "object"
}
