{
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "$ref": "#/$defs/ConfidenceGrade"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "grade",
        "rationale"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceGrade": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "unknown"
      ],
      "title": "ConfidenceGrade",
      "type": "string"
    },
    "HistoricalMapRendering": {
      "additionalProperties": false,
      "description": "A release-local raster positioned from a reviewed IIIF georeference.",
      "properties": {
        "protocol": {
          "const": "iiif-georeference-maplibre-image-v1",
          "default": "iiif-georeference-maplibre-image-v1",
          "title": "Protocol",
          "type": "string"
        },
        "image_path": {
          "pattern": "^historical-maps/[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.(png|jpg|jpeg|webp)$",
          "title": "Image Path",
          "type": "string"
        },
        "image_checksum_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Checksum Sha256",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "image_path",
        "image_checksum_sha256",
        "coordinates"
      ],
      "title": "HistoricalMapRendering",
      "type": "object"
    },
    "ReleaseRightsApproval": {
      "additionalProperties": false,
      "description": "One release decision for one material scope.",
      "properties": {
        "scope": {
          "$ref": "#/$defs/RightsScope"
        },
        "status": {
          "const": "approved",
          "title": "Status",
          "type": "string"
        },
        "decision_id": {
          "pattern": "^rights:[a-z0-9][a-z0-9:_-]+$",
          "title": "Decision Id",
          "type": "string"
        },
        "reviewed_by": {
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "status",
        "decision_id",
        "reviewed_by",
        "reviewed_at",
        "rationale"
      ],
      "title": "ReleaseRightsApproval",
      "type": "object"
    },
    "RightsReference": {
      "additionalProperties": false,
      "description": "A rights decision for one kind of material, never an implicit relicense.",
      "properties": {
        "scope": {
          "$ref": "#/$defs/RightsScope"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "rights_uri": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Uri"
        }
      },
      "required": [
        "scope",
        "license_id",
        "attribution"
      ],
      "title": "RightsReference",
      "type": "object"
    },
    "RightsScope": {
      "enum": [
        "metadata",
        "media",
        "georeference"
      ],
      "title": "RightsScope",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "modified": {
          "default": false,
          "title": "Modified",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "record_id",
        "title",
        "publisher",
        "url",
        "license_id",
        "retrieved_at",
        "citation"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TransformationStep": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        },
        "input_record_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Record Ids",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "operation",
        "tool",
        "tool_version",
        "input_record_ids"
      ],
      "title": "TransformationStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Build-time metadata for a georeferenced IIIF map; no image bytes are embedded.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "map_id": {
      "pattern": "^map:[a-f0-9]{16}$",
      "title": "Map Id",
      "type": "string"
    },
    "manifest_id": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "canvas_id": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Canvas Id",
      "type": "string"
    },
    "annotation_id": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Annotation Id",
      "type": "string"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "depicted_date": {
      "minLength": 1,
      "title": "Depicted Date",
      "type": "string"
    },
    "providers": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Providers",
      "type": "array"
    },
    "required_statement": {
      "minLength": 1,
      "title": "Required Statement",
      "type": "string"
    },
    "metadata_rights": {
      "$ref": "#/$defs/RightsReference"
    },
    "image_rights": {
      "$ref": "#/$defs/RightsReference"
    },
    "georeference_rights": {
      "$ref": "#/$defs/RightsReference"
    },
    "georeference_confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "minItems": 2,
      "title": "Source Refs",
      "type": "array"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/TransformationStep"
      },
      "minItems": 1,
      "title": "Lineage",
      "type": "array"
    },
    "known_limitations": {
      "items": {
        "type": "string"
      },
      "title": "Known Limitations",
      "type": "array"
    },
    "release_rights_approvals": {
      "items": {
        "$ref": "#/$defs/ReleaseRightsApproval"
      },
      "title": "Release Rights Approvals",
      "type": "array"
    },
    "rendering": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistoricalMapRendering"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "map_id",
    "manifest_id",
    "canvas_id",
    "annotation_id",
    "label",
    "depicted_date",
    "providers",
    "required_statement",
    "metadata_rights",
    "image_rights",
    "georeference_rights",
    "georeference_confidence",
    "source_refs",
    "lineage"
  ],
  "title": "HistoricalMapMetadata",
  "type": "object"
}
