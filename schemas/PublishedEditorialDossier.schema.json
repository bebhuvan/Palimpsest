{
  "$defs": {
    "DatePrecision": {
      "enum": [
        "exact",
        "year",
        "decade",
        "century",
        "range",
        "unknown"
      ],
      "title": "DatePrecision",
      "type": "string"
    },
    "DossierDraftClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^draft-claim:[a-z0-9][a-z0-9:_-]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Entity Ids",
          "type": "array"
        },
        "valid_from": {
          "title": "Valid From",
          "type": "integer"
        },
        "valid_to": {
          "title": "Valid To",
          "type": "integer"
        },
        "date_precision": {
          "$ref": "#/$defs/DatePrecision"
        },
        "supporting_assertion_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Assertion Ids",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "text",
        "entity_ids",
        "valid_from",
        "valid_to",
        "date_precision",
        "supporting_assertion_ids",
        "citations"
      ],
      "title": "DossierDraftClaim",
      "type": "object"
    },
    "DossierGenerationProvenance": {
      "additionalProperties": false,
      "properties": {
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "model_identifier": {
          "minLength": 1,
          "title": "Model Identifier",
          "type": "string"
        },
        "evidence_bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Bundle Sha256",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "provider_response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Response Id"
        }
      },
      "required": [
        "prompt_version",
        "prompt_sha256",
        "model_identifier",
        "evidence_bundle_sha256",
        "output_sha256",
        "generated_at"
      ],
      "title": "DossierGenerationProvenance",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "description": "An exact character span used to support one generated claim.",
      "properties": {
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "passage_id": {
          "pattern": "^passage:[a-z0-9][a-z0-9:_-]+$",
          "title": "Passage Id",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "passage_id",
        "start_char",
        "end_char",
        "quote"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "HumanDossierReview": {
      "additionalProperties": false,
      "properties": {
        "reviewed_by": {
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "notes": {
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        },
        "reviewed_claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reviewed Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "reviewed_by",
        "reviewed_at",
        "notes",
        "reviewed_claim_ids"
      ],
      "title": "HumanDossierReview",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "modified": {
          "default": false,
          "title": "Modified",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "record_id",
        "title",
        "publisher",
        "url",
        "license_id",
        "retrieved_at",
        "citation"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable, human-approved editorial data, distinct from source extracts.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "dossier_id": {
      "pattern": "^palimpsest:editorial:[a-f0-9]{16}$",
      "title": "Dossier Id",
      "type": "string"
    },
    "source_draft_id": {
      "pattern": "^dossier-draft:[a-f0-9]{16}$",
      "title": "Source Draft Id",
      "type": "string"
    },
    "dossier_kind": {
      "const": "generated_editorial",
      "default": "generated_editorial",
      "title": "Dossier Kind",
      "type": "string"
    },
    "editorial_state": {
      "const": "published",
      "default": "published",
      "title": "Editorial State",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "language": {
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "entity_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Entity Ids",
      "type": "array"
    },
    "feature_ids": {
      "items": {
        "type": "string"
      },
      "title": "Feature Ids",
      "type": "array"
    },
    "content_role": {
      "const": "project_interpretation",
      "default": "project_interpretation",
      "title": "Content Role",
      "type": "string"
    },
    "extract": {
      "minLength": 1,
      "title": "Extract",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/DossierDraftClaim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "content_checksum_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Checksum Sha256",
      "type": "string"
    },
    "evidence_sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "minItems": 1,
      "title": "Evidence Sources",
      "type": "array"
    },
    "evidence_attributions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Attributions",
      "type": "array"
    },
    "editorial_license_id": {
      "minLength": 1,
      "title": "Editorial License Id",
      "type": "string"
    },
    "editorial_attribution": {
      "minLength": 1,
      "title": "Editorial Attribution",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/DossierGenerationProvenance"
    },
    "review": {
      "$ref": "#/$defs/HumanDossierReview"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    }
  },
  "required": [
    "dossier_id",
    "source_draft_id",
    "title",
    "language",
    "entity_ids",
    "extract",
    "claims",
    "content_checksum_sha256",
    "evidence_sources",
    "evidence_attributions",
    "editorial_license_id",
    "editorial_attribution",
    "generation",
    "review",
    "published_at"
  ],
  "title": "PublishedEditorialDossier",
  "type": "object"
}
