{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "build_id": {
      "title": "Build Id",
      "type": "string"
    },
    "manifest": {
      "pattern": "^builds/[a-z0-9_-]+/manifest\\.json$",
      "title": "Manifest",
      "type": "string"
    },
    "manifest_checksum_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Checksum Sha256",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "build_id",
    "manifest",
    "manifest_checksum_sha256",
    "generated_at"
  ],
  "title": "LatestPointer",
  "type": "object"
}
